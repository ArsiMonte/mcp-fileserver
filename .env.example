# Server Configuration
PORT=3000
HOST=0.0.0.0
TRANSPORT=http # 'http' (Streamable HTTP / SSE) or 'stdio'

# Sandboxed Workspace Directory (Absolute path or relative to project root)
# All file reads, writes, and searches will be strictly jailed inside this directory.
WORKSPACE_ROOT=./workspace

# Security & Authentication (Required for Exemplary Rubric score)
# Set a shared secret token to protect public tunnel endpoints against unauthorized calls.
AUTH_TOKEN=mcp-secret-token-change-me

# Logging
LOG_LEVEL=info # 'debug' | 'info' | 'warn' | 'error'
AUDIT_LOG_FILE=./logs/audit.log
