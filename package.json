{
  "name": "mcp-fileserver",
  "version": "1.0.0",
  "description": "Sandboxed MCP File-Server Connector with Multi-Agent Handoff Protocol, Git-Lite, and Streamable HTTP",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "start:stdio": "tsx src/index.ts --stdio",
    "start:http": "tsx src/index.ts --http",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs mcp-fileserver",
    "test": "vitest run",
    "test:watch": "vitest",
    "tunnel:ngrok": "ngrok http 3000",
    "tunnel:cloudflared": "cloudflared tunnel --url http://localhost:3000"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "filesystem",
    "sandbox",
    "multi-agent",
    "handoff-protocol"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
